# Cloudflare Workers static-assets redirect rules.
# Redirects are evaluated before _headers rules.


# Common alternates so a mistyped or externally-linked URL still lands.
/inicio      /           301
/home        /           301
/servicio    /servicios  301
/galleria    /galeria    301
/gallery     /galeria    301
/about       /nosotros   301
/contact     /contacto   301
/contacto/*  /contacto   301

# Los servicios pasaron de anclas a paginas propias. Las anclas siguen
# funcionando solas (el navegador ignora el fragmento si no existe), pero
# redirigimos los paths para que cualquier link viejo caiga en la URL indexable.
/servicios/camperas-corporativas  /servicios/corporativo   301
/servicios/remeras-buzos          /servicios/clubes-y-equipos 301
/servicios/mochilas-accesorios    /servicios/personalizados 301
/servicios/pedidos-mayoristas     /servicios/uniformes-y-grupos 301
/servicios/gorras-gorros          /servicios/uniformes-y-grupos 301
