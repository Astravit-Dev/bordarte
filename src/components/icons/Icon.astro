---
/**
 * Inline SVG icons. Paths are lifted verbatim from lucide-static so the site
 * ships no icon runtime, no font, and no extra network request — the markup is
 * part of the HTML document that Cloudflare already sent.
 *
 * Icons are decorative by default (`aria-hidden`, removed from the a11y tree).
 * Pass a `title` only when the icon is the sole carrier of meaning; it then
 * becomes an `img` role with an accessible name, which is what the agentic
 * accessibility-tree audit expects.
 */
export type IconName =
  | 'menu'
  | 'x'
  | 'message-circle'
  | 'arrow-right'
  | 'check'
  | 'clock'
  | 'layers'
  | 'at-sign'
  | 'map-pin'
  | 'phone'
  | 'cpu'
  | 'shield-check'
  | 'users'
  | 'truck'
  | 'clipboard-list'
  | 'palette'
  | 'package'
  | 'sparkles'
  | 'whatsapp'

interface Props {
  name: IconName
  class?: string
  /** Accessible name. Omit for decorative icons. */
  title?: string
  strokeWidth?: number
  [key: `data-${string}`]: unknown
}

const { name, class: className, title, strokeWidth = 2, ...rest } = Astro.props

const decorative = !title
// WhatsApp is a filled brand glyph, the rest are lucide's stroked 24x24 grid.
const isBrand = name === 'whatsapp'
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={isBrand ? '0 0 32 32' : '0 0 24 24'}
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? undefined : 'currentColor'}
  stroke-width={isBrand ? undefined : strokeWidth}
  stroke-linecap={isBrand ? undefined : 'round'}
  stroke-linejoin={isBrand ? undefined : 'round'}
  class={className}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title}
  focusable="false"
  {...rest}
>
  {name === 'menu' && (
    <><path d="M4 5h16" /><path d="M4 12h16" /><path d="M4 19h16" /></>
  )}
  {name === 'x' && (
    <><path d="M18 6 6 18" /><path d="m6 6 12 12" /></>
  )}
  {name === 'message-circle' && (
    <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719" />
  )}
  {name === 'arrow-right' && (
    <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>
  )}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {name === 'clock' && (
    <><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></>
  )}
  {name === 'layers' && (
    <>
      <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
      <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
      <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
    </>
  )}
  {name === 'at-sign' && (
    <><circle cx="12" cy="12" r="4" /><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" /></>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === 'phone' && (
    <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
  )}
  {name === 'cpu' && (
    <>
      <path d="M12 20v2" /><path d="M12 2v2" /><path d="M17 20v2" /><path d="M17 2v2" />
      <path d="M2 12h2" /><path d="M2 17h2" /><path d="M2 7h2" /><path d="M20 12h2" />
      <path d="M20 17h2" /><path d="M20 7h2" /><path d="M7 20v2" /><path d="M7 2v2" />
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <rect x="8" y="8" width="8" height="8" rx="1" />
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {name === 'users' && (
    <>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <path d="M16 3.128a4 4 0 0 1 0 7.744" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <circle cx="9" cy="7" r="4" />
    </>
  )}
  {name === 'truck' && (
    <>
      <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
      <path d="M15 18H9" />
      <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" />
      <circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" />
    </>
  )}
  {name === 'clipboard-list' && (
    <>
      <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
      <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
      <path d="M12 11h4" /><path d="M12 16h4" /><path d="M8 11h.01" /><path d="M8 16h.01" />
    </>
  )}
  {name === 'palette' && (
    <>
      <path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z" />
      <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
      <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
      <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
      <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
    </>
  )}
  {name === 'package' && (
    <>
      <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
      <path d="M12 22V12" />
      <polyline points="3.29 7 12 12 20.71 7" />
      <path d="m7.5 4.27 9 5.15" />
    </>
  )}
  {name === 'sparkles' && (
    <>
      <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" />
      <path d="M20 2v4" /><path d="M22 4h-4" />
      <circle cx="4" cy="20" r="2" />
    </>
  )}
  {name === 'whatsapp' && (
    <path d="M16.02 3C9.4 3 4.02 8.38 4.02 15c0 2.32.66 4.5 1.8 6.33L4 29l7.86-1.77A11.9 11.9 0 0 0 16.02 27C22.64 27 28.02 21.62 28.02 15S22.64 3 16.02 3Zm0 21.7c-1.9 0-3.68-.52-5.2-1.44l-.37-.22-4.35.98.94-4.24-.24-.38a9.63 9.63 0 0 1-1.48-5.4c0-5.37 4.37-9.74 9.7-9.74 5.35 0 9.71 4.37 9.71 9.74 0 5.36-4.36 9.7-9.71 9.7Zm5.34-7.28c-.29-.15-1.73-.85-2-.95-.27-.1-.46-.15-.66.15-.2.29-.75.95-.92 1.15-.17.19-.34.22-.63.07-.29-.15-1.22-.45-2.32-1.43-.86-.76-1.44-1.71-1.61-2-.17-.29-.02-.45.13-.6.14-.14.32-.36.48-.55.16-.19.21-.32.32-.53.1-.22.05-.4-.04-.55-.1-.15-.63-1.52-.87-2.08-.23-.55-.47-.48-.66-.49h-.56c-.19 0-.5.07-.76.36-.27.29-1.02 1-1.02 2.43 0 1.44 1.05 2.82 1.19 3.02.15.19 2.06 3.16 5.06 4.3 2.99 1.15 2.99.77 3.53.72.53-.05 1.73-.7 1.98-1.39.24-.68.24-1.26.17-1.39-.07-.12-.26-.19-.55-.34Z" />
  )}
</svg>
