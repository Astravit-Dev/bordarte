---
import Logo from '@/components/Logo.astro'
import Button from '@/components/Button.astro'
import Icon from '@/components/icons/Icon.astro'
import { NAV_LINKS, getWhatsappUrl } from '@/lib/site-config'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="sticky top-0 z-40 border-b border-primary-foreground/10 bg-primary text-primary-foreground">
  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-5 md:px-8">
    <Logo href={pathname === '/' ? null : '/'} priority />

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
      {
        NAV_LINKS.map((link) => {
          const isCurrent = pathname === link.href
          return (
            <a
              href={link.href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'text-sm font-medium tracking-wide transition-colors hover:text-primary-foreground',
                isCurrent ? 'text-primary-foreground' : 'text-on-primary-muted',
              ]}
            >
              {link.label}
            </a>
          )
        })
      }
    </nav>

    <div class="hidden lg:block">
      <Button href={getWhatsappUrl()} external variant="wood" size="md">
        <Icon name="message-circle" class="size-4" />
        Pedir cotización
      </Button>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="flex size-10 items-center justify-center rounded-sm text-primary-foreground lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="menu" class="size-6" data-menu-icon="open" />
      <Icon name="x" class="hidden size-6" data-menu-icon="close" />
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-primary-foreground/10 bg-primary px-5 pb-6 lg:hidden"
    aria-label="Navegación móvil"
  >
    <ul class="flex flex-col gap-1 pt-4">
      {
        NAV_LINKS.map((link) => {
          const isCurrent = pathname === link.href
          return (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={[
                  'block rounded-sm px-3 py-3 text-base font-medium transition-colors hover:bg-primary-foreground/10 hover:text-primary-foreground',
                  isCurrent
                    ? 'bg-primary-foreground/10 text-primary-foreground'
                    : 'text-on-primary-muted',
                ]}
              >
                {link.label}
              </a>
            </li>
          )
        })
      }
    </ul>
    <Button href={getWhatsappUrl()} external variant="wood" size="md" class="mt-4 w-full">
      <Icon name="message-circle" class="size-4" />
      Pedir cotización por WhatsApp
    </Button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')
  const nav = document.getElementById('mobile-nav')

  if (toggle && nav) {
    const openIcon = toggle.querySelector('[data-menu-icon="open"]')
    const closeIcon = toggle.querySelector('[data-menu-icon="close"]')

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación')
      nav.classList.toggle('hidden', !open)
      openIcon?.classList.toggle('hidden', open)
      closeIcon?.classList.toggle('hidden', !open)
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true')
    })

    // Escape closes the menu and returns focus to the trigger.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        toggle.focus()
      }
    })
  }
</script>
