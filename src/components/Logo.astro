---
interface Props {
  variant?: 'light' | 'dark'
  showTagline?: boolean
  /** The header/footer logo links home; on the home page itself it should not. */
  href?: string | null
  class?: string
}

const { variant = 'light', showTagline = true, href = '/', class: className } = Astro.props

const tone = variant === 'light' ? 'text-primary-foreground' : 'text-primary'
const taglineTone = variant === 'light' ? 'text-on-primary-subtle' : 'text-muted-foreground'

const Tag = href ? 'a' : 'div'
---

{/*
  No aria-label: the link's own text ("Bordarte" + the tagline) becomes its
  accessible name. An aria-label that omitted the tagline made the accessible
  name a mismatch for the visible text, which fails WCAG 2.5.3 and confuses
  voice control and browsing agents that target elements by their visible label.
*/}
<Tag href={href ?? undefined} class:list={['group flex items-center gap-2.5', className]}>
  <svg
    viewBox="0 0 48 44"
    class:list={['h-8 w-9 shrink-0 transition-transform group-hover:scale-105', tone]}
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M24 40.5C24 40.5 3 28.7 3 14.8C3 7.6 8.6 3 14.6 3C19 3 22.3 5.4 24 8.8C25.7 5.4 29 3 33.4 3C39.4 3 45 7.6 45 14.8C45 28.7 24 40.5 24 40.5Z"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-dasharray="5.5 5.5"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-script text-3xl leading-none', tone]}>Bordarte</span>
    {
      showTagline && (
        <span class:list={['mt-0.5 text-[9px] font-medium tracking-[0.22em] uppercase', taglineTone]}>
          Bordados que dejan huella
        </span>
      )
    }
  </span>
</Tag>
