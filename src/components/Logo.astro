---
import { Picture } from 'astro:assets'
import logo from '@/assets/brand/logo-bordarte.png'

/**
 * The real embroidered wordmark, replacing the previous script-font rendering.
 *
 * The artwork is white with a soft grey relief, so it only works on the dark
 * navy `--primary` surface — which is the only place the logo appears (header
 * and footer). There is deliberately no light-background variant: shipping one
 * prop that renders an invisible logo is worse than not having the option.
 *
 * The tagline stays as live text rather than using the version baked into the
 * source lockup: at header size that baked text renders about 8 px tall and
 * turns to mush, and as markup it stays selectable, translatable and legible.
 */
interface Props {
  /** The header/footer logo links home; on the home page itself it should not. */
  href?: string | null
  showTagline?: boolean
  /** Above the fold in the header, below it in the footer. */
  priority?: boolean
  /** Tailwind height utility for the wordmark. */
  size?: string
  class?: string
}

const {
  href = '/',
  showTagline = true,
  priority = false,
  size = 'h-11',
  class: className,
} = Astro.props

const Tag = href ? 'a' : 'div'
---

<Tag
  href={href ?? undefined}
  class:list={['group inline-flex flex-col gap-1', className]}
>
  {/*
    AVIF first: the wordmark is a soft relief with an alpha channel, which AVIF
    stores far more cheaply than WebP — the 2x rendition drops from ~27 kB to
    ~16 kB, and this asset sits above the fold on every page.

    `fetchpriority="low"` matters more than it looks. Left at the default the
    logo raced the hero photo for bandwidth and pushed the home page's LCP from
    1.97 s to 2.42 s. It is eager so it still paints early, but it yields to the
    image the score is actually measured on.
  */}
  <Picture
    src={logo}
    alt="Bordarte"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    width={220}
    densities={[1, 2]}
    quality={68}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority="low"
    class:list={[size, 'w-auto transition-transform group-hover:scale-[1.02]']}
  />
  {
    showTagline && (
      <span class="text-[9px] font-medium tracking-[0.22em] text-on-primary-subtle uppercase">
        Bordados que dejan huella
      </span>
    )
  }
</Tag>
